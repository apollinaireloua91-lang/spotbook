# Copier vers .env (non versionné) — voir .cursor/MCP_STITCH.md
#
# ─── Flutter (dart-define / dotenv) — JAMAIS service_role ni clés Stripe ici ───
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# CLOUDFLARE_CUSTOMER_CODE=   # sous-domaine customer-xxx pour les URLs manifest HLS
#
# ─── Secrets UNIQUEMENT côté Supabase (Edge Functions → Dashboard Secrets) ───
# Google OAuth (Supabase Auth → Dashboard → Auth → Providers → Google)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=1084162491451-ce829llikqg167f88ip1cun5v5abotet.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<Google OAuth client secret depuis GCP Console>
#
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN
# QR_SIGNING_SECRET           # min 16 caractères (billets)
# FCM_PROJECT_ID, FCM_SERVER_KEY
# EDGE_CORS_ORIGIN=https://getspotbook.app
# EDGE_ALLOWED_ORIGINS=https://getspotbook.app,https://www.getspotbook.app
# SPOTBOOK_WEB_BASE_URL=https://getspotbook.app   # return_url Stripe Connect
# CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=false     # true = prévoir tokens lecture dans l’app
#
# Resend (emails transactionnels — noreply@getspotbook.app)
# RESEND_API_KEY=re_xxxxxxxxxxxx  # Resend Dashboard → API Keys
# DNS Cloudflare : voir docs/RESEND_DNS_SETUP.md pour SPF/DKIM/DMARC
#
# Spotify (OAuth pro — feed musique). Dashboard : Redirect URI exact
#   app.spotbook://spotify-callback
# Edge Functions (secrets Supabase) : SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET,
#   SPOTIFY_REDIRECT_URI=app.spotbook://spotify-callback
#SPOTIFY_CLIENT_ID=
#SPOTIFY_REDIRECT_URI=app.spotbook://spotify-callback
# Télécharger maquettes Stitch : npm run stitch:fetch-onboarding
# STITCH_API_KEY=... (Stitch → Settings → API Keys) — le plus simple
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# STITCH_ACCESS_TOKEN=from: gcloud auth application-default print-access-token
#
# Doc infra : docs/INFRASTRUCTURE_PRODUCTION.md
